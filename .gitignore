# ============================================
# DEPENDENCIAS DEL ENTORNO DE DESARROLLO
# ============================================
node_modules/
.npm
package-lock.json

.vscode

# ============================================
# BUILD OUTPUTS
# ============================================
storybook-static/
build/

# Excepciones: mantener el .gitkeep para que la carpeta exista en el repo
!app/verge3d_assets/.gitkeep

# ============================================
# ARCHIVOS DE SISTEMA OPERATIVO
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ============================================
# EDITORES E IDEs
# ============================================
# VSCode (mantener settings.json del equipo si existe)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (WebStorm, etc.)
.idea/
*.iml
*.iws

# Vim / Emacs
*.swp
*.swo
.#*

# ============================================
# LOGS Y DEBUG
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# VARIABLES DE ENTORNO (si en el futuro se agregan)
# ============================================
.env
.env.local
.env.*.local

# ============================================
# CACHÉ
# ============================================
.cache/
.eslintcache
.stylelintcache
